# Normalize line endings so the same file does not show as modified on every
# clone depending on the operating system.
* text=auto eol=lf

# Windows and shell scripts must keep their CRLF endings or they will not run.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Lockfiles are generated; keep diffs readable but consistent.
package-lock.json text eol=lf