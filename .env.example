# Local dev: DB in Docker, app via `npm run dev`
# Full-stack preview: docker compose --profile full up --build
DATABASE_URL=postgres://orkut:orkut@localhost:5432/orkut

# Signs two-factor challenges and derives the TOTP encryption key.
AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars

# Base URL used to build email verification links.
APP_URL=http://localhost:3000

# Mail transport: console (default), resend, postmark, ses, or smtp.
# See docs/mail.md for the credentials each one needs.
#MAIL_PROVIDER=console
#RESEND_API_KEY=
#POSTMARK_SERVER_TOKEN=
#AWS_REGION=
#SMTP_HOST=

# Sender address for every hosted transport. Each provider falls back to a
# placeholder if this is unset, and the placeholder will be rejected in
# practice: Resend only accepts its own onboarding address, and SES has to have
# the domain verified. Set it for anything other than local development.
#MAIL_FROM="orkut <no-reply@yourdomain.com>"

# Two-factor (TOTP). Optional: when unset, the AES-256-GCM key for TOTP secrets is
# derived from AUTH_SECRET, which is safe but couples the two. Set it explicitly in
# production so rotating AUTH_SECRET does not invalidate every enrolled secret.
# Must be 32 bytes, as 64 hex characters or base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#TOTP_ENCRYPTION_KEY=

# Where uploaded photos are written. Outside public/, and served by /uploads/[name].
#UPLOAD_DIR=./data/uploads

# Defaults to on. Signup will not create a session until the address is verified.
#REQUIRE_EMAIL_VERIFICATION=true

# How many reverse proxies sit in front of the app, and therefore how many
# entries at the right-hand end of X-Forwarded-For were appended by something
# we control. The rate limiters read the rightmost entry rather than the leftmost
# one, because the leftmost is whatever the client sent. Raise this if a CDN sits
# in front of a load balancer (2), lower it never below 1.
#TRUSTED_PROXY_HOPS=1