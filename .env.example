# Local dev: DB in Docker, app via `npm run dev`
# Full-stack preview: docker compose --profile full up --build
DATABASE_URL=postgres://orkut:orkut@localhost:5432/orkut

# Signs two-factor challenges and derives the TOTP encryption key.
AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars

# Base URL used to build email verification links.
APP_URL=http://localhost:3000

# Mail transport: console (default), resend, postmark, ses, or smtp.
# See docs/mail.md for the credentials each one needs.
#MAIL_PROVIDER=console
#RESEND_API_KEY=
#POSTMARK_SERVER_TOKEN=
#AWS_REGION=
#SMTP_HOST=

# Two-factor (TOTP). Optional: when unset, the AES-256-GCM key for TOTP secrets is
# derived from AUTH_SECRET, which is safe but couples the two. Set it explicitly in
# production so rotating AUTH_SECRET does not invalidate every enrolled secret.
# Must be 32 bytes, as 64 hex characters or base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#TOTP_ENCRYPTION_KEY=

# Where uploaded photos are written. Outside public/, and served by /uploads/[name].
#UPLOAD_DIR=./data/uploads

# Defaults to on. Signup will not create a session until the address is verified.
#REQUIRE_EMAIL_VERIFICATION=true