{
    "name": "orkut",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "verify:totp": "node --experimental-strip-types --no-warnings ./scripts/verify-totp.ts",
        "verify:password": "node --experimental-strip-types --no-warnings ./scripts/verify-password.ts",
        "verify:client-ip": "node --experimental-strip-types --no-warnings ./scripts/verify-client-ip.ts",
        "verify:mail": "node --experimental-strip-types --no-warnings ./scripts/verify-mail-provider.ts",
        "verify": "npm run verify:totp && npm run verify:password && npm run verify:client-ip && npm run verify:mail"
    },
    "dependencies": {
        "@node-rs/argon2": "^2.2.2",
        "drizzle-orm": "^0.44.0",
        "next": "16.4.0",
