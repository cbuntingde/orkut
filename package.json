        "postgres": "^3.4.5",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/turbopack": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.4.0",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
