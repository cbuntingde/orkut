# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# agent and planning documents. These are working notes for development, not part
# of the project, and are never committed.
AGENTS.md
CLAUDE.md
GEMINI.md
.cursorrules
PLAN.md
TODO.md
NOTES.md
# per-project agent memory written by tooling
.agents/

# Markdown under docs/ is development notes. The screenshots alongside them are
# product assets referenced by README.md, so they stay tracked.
docs/*.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

pgdata/
init.sql.bak

# uploaded photos, written outside public/ and served by /uploads/[name]
/data/
